# Server-side only — never expose these to the browser.
# Set the real values in Vercel Project Settings → Environment Variables.
# Do not commit a filled-in .env file.

# Resend API key (from https://resend.com/api-keys)
RESEND_API_KEY=

# Inbox that should receive "Start a Project" enquiries
CONTACT_TO_EMAIL=

# Verified Resend sender address (must belong to a domain verified in Resend,
# e.g. hello@yourdomain.com — a raw Gmail address will NOT work as a sender)
CONTACT_FROM_EMAIL=
